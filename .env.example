# Copier ce fichier en .env puis changer les mots de passe.
# Le fichier .env n'est jamais versionné.

TZ=Indian/Antananarivo

# PostgreSQL
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=admission
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=admission
POSTGRES_PORT=5432

# Base séparée pour les données internes de n8n
N8N_DB=n8n

# n8n — épingler une version précise après le premier démarrage réussi
N8N_VERSION=2.40.7
N8N_PORT=5678
# Générer avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=remplacer-par-une-cle-aleatoire

# Service d'extraction Python
EXTRACTEUR_PORT=8000

# Mailpit (faux serveur SMTP, interface web)
MAILPIT_UI_PORT=8025

# Grafana (profil optionnel « tableau »)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-moi
# Compte PostgreSQL en lecture seule utilisé par Grafana
GRAFANA_DB_USER=lecteur_grafana
GRAFANA_DB_PASSWORD=change-moi-aussi
