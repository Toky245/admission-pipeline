    {
      "id": 7,
      "type": "timeseries",
      "title": "Exécutions dans le temps",
      "description": "Une exécution = un dossier traité par le flux n8n (ou le simulateur).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "admission-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "admission-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(debut, $__interval), count(*) FILTER (WHERE statut = 'reussie') AS \"Réussies\", count(*) FILTER (WHERE statut = 'echouee') AS \"Échouées\", count(*) FILTER (WHERE statut = 'interrompue') AS \"Interrompues\" FROM pilotage.executions WHERE $__timeFilter(debut) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Réussies"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56A64B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Échouées"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E02F44"
                }
              }
            ]
