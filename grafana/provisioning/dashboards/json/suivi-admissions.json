    {
      "id": 2,
      "type": "stat",
      "title": "Dossiers complets",
      "description": "Part des dossiers décidés qui sont complets (les autres sont incomplets ou rejetés).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "admission-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "admission-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE statut = 'complet') / nullif(count(*) FILTER (WHERE statut IN ('complet','incomplet','rejete')), 0), 1) FROM inscription.dossiers WHERE $__timeFilter(recu_le)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
