            "uid": "admission-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE statut = 'reussie') / nullif(count(*) FILTER (WHERE statut <> 'en_cours'), 0), 1) FROM pilotage.executions WHERE $__timeFilter(debut)"
