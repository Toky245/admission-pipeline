          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE statut WHEN 'complet' THEN 'Complet' WHEN 'incomplet' THEN 'Incomplet' ELSE 'Rejeté' END AS \"Décision\", count(*) AS \"Dossiers\" FROM inscription.dossiers WHERE $__timeFilter(recu_le) AND statut IN ('complet','incomplet','rejete') GROUP BY 1 ORDER BY 2 DESC"
