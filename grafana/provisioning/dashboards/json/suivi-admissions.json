    },
    {
      "id": 3,
      "type": "stat",
      "title": "Exécutions réussies du premier coup",
      "description": "Exécutions closes avec succès. Une exécution en échec n'est pas un dossier perdu : il est repris ensuite.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
